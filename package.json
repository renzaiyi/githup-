{
  "name": "github-smart-translate",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "GitHub 网页智能翻译扩展（Manifest V3，内容脚本单文件打包）",
  "scripts": {
    "build": "node scripts/build-content.js --expose",
    "test": "node --test tests/core.test.js tests/dom.test.js tests/bundle.test.js tests/search.test.js",
    "check": "node scripts/check.js",
    "bindings": "node scripts/check-bindings.js",
    "probe": "node scripts/verify-bundle.js",
    "verify": "npm run build && npm run bindings && npm test && npm run check"
  },
  "devDependencies": {
    "jsdom": "^30.1.1"
  }
}
